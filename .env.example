# Copy this file to `.env` and fill in your own values.
# `.env` is already excluded in .gitignore — never commit your real token.

# Your bot's token, from https://discord.com/developers/applications
# -> your application -> Bot -> Reset Token. Treat this like a password.
DISCORD_TOKEN=

# Optional. The ID of a server you own, used for testing.
# When set, slash commands register to just this server (near-instant).
# When unset, commands register globally (can take up to an hour to
# appear everywhere) — that's what you want for a real launch.
#
# To get a server's ID: User Settings -> Advanced -> enable Developer
# Mode, then right-click the server icon -> Copy Server ID.
TEST_GUILD_ID=

# Required. Supabase's *direct* Postgres connection string (Project
# Settings -> Database -> Connection string -> URI) — NOT the pooler
# connection, and NOT the service_role key (that's for the website's
# Supabase HTTP client; this is a real Postgres wire-protocol connection).
# Looks like: postgres://postgres.xxxx:[password]@xxxx.supabase.com:5432/postgres
DATABASE_URL=

# Optional for the bot, required for the verification website.
# From your Discord application -> OAuth2 -> Client Secret.
# Leave blank to run the bot without the web verification flow.
DISCORD_CLIENT_SECRET=

# Optional. The public URL users open in their browser. This must match the
# redirect URI configured in the Discord Developer Portal once deployed.
# Defaults to http://localhost:8080 for local development.
PUBLIC_BASE_URL=

# Optional. Local address the built-in axum web server binds to.
# Defaults to 127.0.0.1:8080.
WEB_BIND_ADDR=

# Optional. Blackwall's own official support/community server ID. If unset,
# the support-server-join feature is unavailable everywhere, even for
# servers that ran `/setup support_server_join:true`.
SUPPORT_GUILD_ID=

# Optional. A plain public Discord invite link (e.g. https://discord.gg/xxxx)
# for the support server above. Shown on the /support page and used as the
# manual join fallback. Separate from SUPPORT_GUILD_ID, which is only used
# for the automatic OAuth join.
SUPPORT_SERVER_INVITE_URL=
